rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Autorización parental (imagen o PDF al inscribirse o en lista de espera)
    match /parental_auth/{eventId}/{fileName} {
      function isFileOwner() {
        return request.auth != null
          && (fileName == request.auth.uid + '.jpg'
              || fileName == request.auth.uid + '.jpeg'
              || fileName == request.auth.uid + '.png'
              || fileName == request.auth.uid + '.webp'
              || fileName == request.auth.uid + '.pdf');
      }
      function isEventOrganizer() {
        return request.auth != null
          && firestore.get(/databases/(default)/documents/events/$(eventId)).data.userId
            == request.auth.uid;
      }

      allow read: if isFileOwner() || isEventOrganizer();
      allow create, update: if isFileOwner()
          && request.resource.size < 10 * 1024 * 1024
          && (request.resource.contentType.matches('image/.*')
              || request.resource.contentType == 'application/pdf');
      allow delete: if isFileOwner() || isEventOrganizer();
    }

    match /{allPaths=**} {
      // Permitir leer (descargar/listar) solo a usuarios autenticados
      allow read: if request.auth != null;

      // Permitir subir (create) solo imágenes de menos de 5MB y usuarios autenticados
      allow create: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Permitir actualizar (update) solo imágenes de menos de 5MB y usuarios autenticados
      allow update: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Permitir borrar (delete) solo a usuarios autenticados
      allow delete: if request.auth != null;
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Autorización parental (imagen o PDF al inscribirse o en lista de espera)
    match /parental_auth/{eventId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
          && request.resource.size < 10 * 1024 * 1024
          && (request.resource.contentType.matches('image/.*')
              || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      // Permitir leer (descargar/listar) solo a usuarios autenticados
      allow read: if request.auth != null;

      // Permitir subir (create) solo imágenes de menos de 5MB y usuarios autenticados
      allow create: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Permitir actualizar (update) solo imágenes de menos de 5MB y usuarios autenticados
      allow update: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Permitir borrar (delete) solo a usuarios autenticados
      allow delete: if request.auth != null;
    }
  }
}
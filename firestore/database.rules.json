{
  "rules": {
    // Bloqueo por defecto. Realtime Database no guarda el modelo de Eventum
    // (eventos, inscripciones, waitlist van en Firestore). Estas reglas cubren
    // la instancia RTDB por si queda inicializada en FirebaseManager.
    ".read": false,
    ".write": false,

    // Zona por-usuario: app/<uid>/...
    "app": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",

        "$any": {
          ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean() || newData.hasChildren()"
        }
      }
    },

    // Zona por-evento: events/<eventId>/...
    // Solo el organizador. Requiere eventOwners/<eventId> = <ownerUid>.
    // RTDB no puede consultar Firestore: el owner hay que duplicarlo aquí.
    "events": {
      "$eventId": {
        ".read": "auth != null && root.child('eventOwners').child($eventId).val() == auth.uid",
        ".write": "auth != null && root.child('eventOwners').child($eventId).val() == auth.uid",

        "live": {
          "$key": {
            ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean() || newData.hasChildren()"
          }
        }
      }
    },

    // Mapa de propietarios: eventOwners/<eventId> = <ownerUid>
    "eventOwners": {
      "$eventId": {
        ".read": "auth != null && root.child('eventOwners').child($eventId).val() == auth.uid",
        ".write": "auth != null && ( // crear si no existe y el usuario se autoasigna
           (!data.exists() && newData.isString() && newData.val() == auth.uid) ||
           // actualizar solo si ya es el propietario (no transfiere ni borra)
           (data.exists() && data.val() == auth.uid && newData.isString() && newData.val() == auth.uid)
        )"
      }
    }
  }
}

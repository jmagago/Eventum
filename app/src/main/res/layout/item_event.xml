<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Encabezado con fondo azul claro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_event_card_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/eventImageView"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/cd_event_photo"
                android:src="@mipmap/ic_launcher"
                app:civ_border_color="@color/colorPrimaryLight"
                app:civ_border_width="1dp" />

            <TextView
                android:id="@+id/eventTitleTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/eventPrivateIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_lock_closed"
                app:tint="@color/colorPrimary"
                android:contentDescription="@string/cd_event_private"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:visibility="gone"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/colorPrimary"
                android:contentDescription="@null"
                android:layout_gravity="center_vertical"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/eventDateTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:drawablePadding="8dp"
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    app:drawableStartCompat="@drawable/ic_calendar"
                    app:drawableTint="@color/colorPrimary" />

                <TextView
                    android:id="@+id/eventTimeTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:drawablePadding="8dp"
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    app:drawableStartCompat="@drawable/ic_time"
                    app:drawableTint="@color/colorPrimary" />

                <TextView
                    android:id="@+id/eventLocationTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:drawablePadding="8dp"
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    app:drawableStartCompat="@drawable/ic_location"
                    app:drawableTint="@color/colorPrimary" />

                <TextView
                    android:id="@+id/eventParticipantsTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondaryText"
                    app:drawableStartCompat="@drawable/ic_people"
                    app:drawableTint="@color/colorPrimary" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/eventQrButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/attendee_qr_content_desc"
                android:padding="10dp"
                android:src="@drawable/ic_qr_code_card"
                android:visibility="gone"
                app:tint="@color/colorAccent" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

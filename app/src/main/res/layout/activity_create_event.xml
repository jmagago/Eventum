<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        app:elevation="4dp">

        <View
            android:id="@+id/statusBarStripe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/login_header_bg" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/ScreenToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimary"
            app:title="@string/create_event_title"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Sección: Información Básica -->
                <TextView
                    style="@style/FormSectionTitle"
                    android:text="@string/section_basic_info"
                    android:layout_marginBottom="12dp"/>

                <!-- Nombre del evento -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/nombreEventoLayout"
                    style="@style/Widget.Eventum.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/hint_event_name"
                    app:startIconDrawable="@drawable/ic_title"
                    app:startIconTint="@color/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nombreEventoEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords|textNoSuggestions"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Tipo de evento -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tipoEventoLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/hint_event_type"
                    app:boxStrokeColor="@color/colorPrimary"
                    app:hintTextColor="@color/colorPrimary"
                    app:errorTextColor="@android:color/holo_red_light"
                    app:startIconDrawable="@drawable/ic_check_circle"
                    app:startIconTint="@color/colorPrimary">

                    <AutoCompleteTextView
                        android:id="@+id/tipoEventoAutoComplete"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_event_type"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Programación: Fecha y Hora en dos columnas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <!-- Fecha del evento -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/fechaEventoLayout"
                            style="@style/Widget.Eventum.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_event_date"
                            app:helperText="@string/helper_date_format"
                            app:startIconDrawable="@drawable/ic_calendar"
                            app:startIconTint="@color/colorPrimary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/fechaEventoEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                style="@style/TextAppearance.Eventum.Input"
                                android:focusable="false"
                                android:inputType="none" />

                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <!-- Hora de inicio -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/horaEventoLayout"
                            style="@style/Widget.Eventum.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_event_start_time"
                            app:helperText="@string/helper_time_format_24h"
                            app:startIconDrawable="@drawable/ic_time"
                            app:startIconTint="@color/colorPrimary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/horaEventoEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                style="@style/TextAppearance.Eventum.Input"
                                android:focusable="false"
                                android:inputType="none" />

                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Separador visual sutil -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorBorder"
                    android:layout_marginBottom="16dp"/>

                <!-- Sección: Detalles del Evento -->
                <TextView
                    style="@style/FormSectionTitle"
                    android:text="@string/section_event_details"
                    android:layout_marginBottom="12dp"/>

                <!-- Lugar del evento -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/lugarEventoLayout"
                    style="@style/Widget.Eventum.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/hint_event_location"
                    app:helperText="@string/helper_location_brief"
                    app:startIconDrawable="@drawable/ic_location"
                    app:startIconTint="@color/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/lugarEventoEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.Eventum.Input"
                        android:inputType="textCapWords|textNoSuggestions" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Máximo asistentes -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/maxParticipantesLayout"
                    style="@style/Widget.Eventum.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/hint_event_max_attendees"
                    app:helperText="@string/helper_max_attendees"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/maxParticipantesEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.Eventum.Input"
                        android:inputType="number" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Checkboxes para evento privado y autorización parental -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/eventoPrivadoCheckBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_event_private"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/colorPrimary"
                        app:buttonTint="@color/colorAccent" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/requiresParentalAuthCheckBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_parental_auth"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/colorPrimary"
                        app:buttonTint="@color/colorAccent" />

                </LinearLayout>

                <!-- Descripción del evento (opcional) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/descripcionEventoLayout"
                    style="@style/Widget.Eventum.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:hint="@string/hint_event_description_optional"
                    app:helperText="@string/helper_event_description"
                    app:startIconDrawable="@drawable/ic_description"
                    app:startIconTint="@color/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/descripcionEventoEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.Eventum.Input"
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:gravity="top|start" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botón de crear evento -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/crearEventoButton"
                    style="@style/Widget.Eventum.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/create_event_button"
                    app:icon="@drawable/ic_check_circle"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout> 

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/filterAttendeeStatusLayout"
        style="@style/Widget.Eventum.TextInputLayout.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="@string/filter_attendee_status"
        app:startIconDrawable="@drawable/ic_people"
        app:startIconTint="@color/colorPrimary">

        <AutoCompleteTextView
            android:id="@+id/filterAttendeeStatusAutoComplete"
            style="@style/TextAppearance.Eventum.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/filter_attendee_status"
            android:inputType="none"
            android:popupBackground="@drawable/bg_dropdown_popup" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/filterAttendeeTypeLayout"
        style="@style/Widget.Eventum.TextInputLayout.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="@string/search_events_type_hint"
        app:startIconDrawable="@drawable/ic_check_circle"
        app:startIconTint="@color/colorPrimary">

        <AutoCompleteTextView
            android:id="@+id/filterAttendeeTypeAutoComplete"
            style="@style/TextAppearance.Eventum.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:hint="@string/search_events_type_hint"
            android:inputType="none"
            android:maxLines="1"
            android:popupBackground="@drawable/bg_dropdown_popup" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Eventum.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="@string/search_events_location_hint"
        app:startIconDrawable="@drawable/ic_location"
        app:startIconTint="@color/colorPrimary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/filterAttendeeLocationEditText"
            style="@style/TextAppearance.Eventum.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/search_events_date_range"
        android:textColor="@color/colorPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Eventum.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:hint="@string/search_events_date_from"
            app:startIconDrawable="@drawable/ic_calendar"
            app:startIconTint="@color/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/filterAttendeeDateFromEditText"
                style="@style/TextAppearance.Eventum.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Eventum.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:hint="@string/search_events_date_to"
            app:startIconDrawable="@drawable/ic_calendar"
            app:startIconTint="@color/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/filterAttendeeDateToEditText"
                style="@style/TextAppearance.Eventum.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

</LinearLayout>

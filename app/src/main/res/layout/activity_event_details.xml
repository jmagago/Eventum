<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/CustomToolbar">

            <LinearLayout
                style="@style/ToolbarProfileContainer">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_arrow_back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="@color/white"
                    android:padding="12dp"
                    android:contentDescription="Volver atrás"/>

                <TextView
                    android:id="@+id/toolbarTitleTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    style="@style/ToolbarTitleStyleDark"/>

                <ImageButton
                    android:id="@+id/eventMenuButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_more_vert"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="@color/white"
                    android:padding="12dp"
                    android:contentDescription="Menú del evento"/>

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Información fija del evento -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#F0F8FF"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:background="@drawable/card_background_ripple">

                <TextView
                    android:id="@+id/eventDateTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/colorSecondaryText"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_time_colored"
                        android:layout_gravity="center_vertical"/>

                    <TextView
                        android:id="@+id/eventTimeTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:textSize="16sp"
                        android:textColor="@color/colorSecondaryText"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/eventCapacityTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/colorSecondaryText"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp"
                    android:id="@+id/verifiedLayout">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_verified"
                        android:layout_gravity="center_vertical"/>

                    <TextView
                        android:id="@+id/verifiedTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:textSize="16sp"
                        android:textColor="@color/colorSecondaryText"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/eventLocationTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/colorSecondaryText"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:visibility="gone"
                    android:id="@+id/descriptionSpacer"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:id="@+id/descriptionLayout">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_description"
                        android:tint="@color/colorPrimary"
                        android:layout_gravity="center_vertical"/>

                    <TextView
                        android:id="@+id/eventDescriptionTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:textSize="16sp"
                        android:textColor="@color/colorSecondaryText"/>
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Mensaje cuando no hay asistentes -->
        <TextView
            android:id="@+id/emptyAttendeesTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No hay asistentes registrados para este evento"
            android:textColor="@color/colorPrimary"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="24dp"
            android:layout_margin="16dp"
            android:visibility="gone"/>

        <!-- Lista de asistentes con scroll -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/attendeesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            android:paddingBottom="5dp"/>

    </LinearLayout>

    <!-- Overlay para detectar gestos (parte inferior) -->
    <View
        android:id="@+id/gestureOverlay"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="0dp"
        android:background="@android:color/transparent" />

    <!-- Contenedor de FABs (similar a Home) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fabContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- Buscar asistente (izquierda) -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/searchAttendeeFab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ic_search_person"
                app:backgroundTint="@color/colorAccent"
                app:tint="@color/white"
                app:fabSize="normal"
                app:maxImageSize="44dp"
                app:borderWidth="0dp"
                app:elevation="8dp" />

            <!-- Añadir asistente (centro) -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/addAttendeeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_add"
                app:backgroundTint="@color/colorPrimary"
                app:tint="@color/colorWhite"
                app:fabSize="normal"
                app:maxImageSize="32dp"
                app:borderWidth="0dp"
                app:elevation="8dp" />

            <!-- Verificar por QR (derecha) -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/verifyQrFab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_qr_code"
                app:backgroundTint="@color/colorPrimaryDark"
                app:tint="@color/colorWhite"
                app:fabSize="normal"
                app:maxImageSize="28dp"
                app:borderWidth="0dp"
                app:elevation="8dp" />

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout> 
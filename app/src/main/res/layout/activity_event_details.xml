<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:elevation="0dp">

        <View
            android:id="@+id/statusBarStripe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/login_header_bg" />

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/CustomToolbar">

            <LinearLayout
                style="@style/ToolbarProfileContainer">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/toolbarEventImageView"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/cd_event_photo"
                    android:src="@mipmap/ic_launcher"
                    app:civ_border_color="@color/colorPrimaryLight"
                    app:civ_border_width="1dp" />

                <TextView
                    android:id="@+id/toolbarTitleTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    style="@style/ToolbarTitleStyleDark"/>

                <ImageButton
                    android:id="@+id/eventMenuButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_more_vert"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/white"
                    android:padding="12dp"
                    android:contentDescription="@string/cd_event_menu"/>

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Información fija del evento -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#F0F8FF"
            app:strokeWidth="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:background="@drawable/card_background_ripple">

                <ImageView
                    android:id="@+id/eventPrivateIconDetails"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:src="@drawable/ic_lock_closed"
                    app:tint="@color/colorPrimary"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:visibility="gone"
                    android:contentDescription="@string/cd_event_private"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toStartOf="@id/eventPrivateIconDetails"
                    android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/eventDateTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/colorSecondaryText"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/eventTimeTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:drawablePadding="8dp"
                    android:textSize="16sp"
                    android:textColor="@color/colorSecondaryText"
                    app:drawableStartCompat="@drawable/ic_time_colored" />

                <TextView
                    android:id="@+id/eventCapacityTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/colorSecondaryText"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/verifiedTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:drawablePadding="8dp"
                    android:textSize="16sp"
                    android:textColor="@color/colorSecondaryText"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_verified" />

                <TextView
                    android:id="@+id/eventLocationTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/colorSecondaryText"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:visibility="gone"
                    android:id="@+id/descriptionSpacer"/>

                <TextView
                    android:id="@+id/eventDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:textSize="16sp"
                    android:textColor="@color/colorSecondaryText"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_description"
                    app:drawableTint="@color/colorPrimary" />

                </LinearLayout>

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Filter indicator -->
        <LinearLayout
            android:id="@+id/filterIndicatorLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@color/colorAccent"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search_person"
                app:tint="@color/white"
                android:contentDescription="@null"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/filterIndicatorText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_active_indicator"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/clearFiltersButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_clear"
                app:tint="@color/white"
                android:contentDescription="@string/search_clear"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp" />

        </LinearLayout>

        <!-- Deslizar hacia abajo para actualizar asistentes (mismo patrón que la lista de eventos) -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/attendeesSwipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/attendeesRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp"
                    android:clipToPadding="false"
                    android:paddingBottom="0dp"/>

                <TextView
                    android:id="@+id/emptyAttendeesTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/event_no_attendees"
                    android:textColor="@color/colorPrimary"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:padding="24dp"
                    android:layout_margin="16dp"
                    android:visibility="gone"/>

            </FrameLayout>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/fabDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/fab_bar_margin_bottom"
        android:clipChildren="false"
        android:clipToPadding="false">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fabContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/fab_bar_background"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="6dp"
            android:paddingBottom="10dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/searchAttendeeFab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_fab_search_attendees"
                app:srcCompat="@drawable/ic_search_person"
                app:backgroundTint="@color/colorAccent"
                app:tint="@color/white"
                app:fabSize="normal"
                app:maxImageSize="44dp"
                app:borderWidth="0dp"
                app:elevation="4dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/addAttendeeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_fab_add_attendee"
                android:src="@drawable/ic_add"
                app:backgroundTint="@color/colorPrimary"
                app:tint="@color/colorWhite"
                app:fabSize="normal"
                app:maxImageSize="32dp"
                app:borderWidth="0dp"
                app:elevation="4dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/verifyQrFab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_fab_scan_qr"
                android:src="@drawable/ic_qr_code"
                app:backgroundTint="@color/colorPrimaryDark"
                app:tint="@color/colorWhite"
                app:fabSize="normal"
                app:maxImageSize="28dp"
                app:borderWidth="0dp"
                app:elevation="4dp" />

            <FrameLayout
                android:id="@+id/fabBarCollapse"
                android:layout_width="@dimen/fab_bar_handle_width"
                android:layout_height="@dimen/fab_bar_handle_height"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_fab_bar_handle"
                android:clickable="true"
                android:contentDescription="@string/fab_bar_collapse_actions"
                android:elevation="@dimen/fab_bar_handle_elevation"
                android:focusable="true"
                android:scaleX="-1">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleX="-1"
                    app:srcCompat="@drawable/ic_chevron_right"
                    app:tint="@android:color/white" />

            </FrameLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/fabBarHandle"
        android:layout_width="@dimen/fab_bar_handle_width"
        android:layout_height="@dimen/fab_bar_handle_height"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_fab_bar_handle"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:contentDescription="@string/fab_bar_show_actions"
        android:elevation="@dimen/fab_bar_handle_elevation">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:scaleX="-1"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_chevron_right"
            app:tint="@android:color/white" />
    </FrameLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout> 

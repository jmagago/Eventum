<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        app:elevation="0dp">

        <!-- Franja azul de "safe area" para status bar / notch -->
        <View
            android:id="@+id/statusBarStripe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/login_header_bg" />

        <include
            android:id="@+id/userHeader"
            layout="@layout/include_user_header" />

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"/>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Filter indicator -->
        <LinearLayout
            android:id="@+id/filterIndicatorLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@color/colorAccent"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="@color/white"
                android:contentDescription="@null"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/filterIndicatorText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_active_indicator"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/clearFiltersButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_clear"
                app:tint="@color/white"
                android:contentDescription="@string/search_clear"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/sortFutureEventsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/organizer_sort_events"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_sort"
                app:tint="@color/colorPrimary" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                app:tabGravity="fill"
                app:tabMode="fixed"
                app:tabTextColor="@color/colorSecondaryText"
                app:tabSelectedTextColor="@color/colorPrimary"
                app:tabIndicatorColor="@color/colorPrimary"
                app:tabIndicatorHeight="3dp"
                app:tabIndicatorFullWidth="true" />

        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
                android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="0dp"
            android:paddingBottom="5dp" />

        </LinearLayout>

    <FrameLayout
        android:id="@+id/fabDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/fab_bar_margin_bottom"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fabContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/fab_bar_background"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="6dp"
                android:paddingBottom="10dp">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/searchEventsFab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/cd_fab_search"
                    app:srcCompat="@drawable/ic_search"
                    app:backgroundTint="@color/colorAccent"
                    app:tint="@color/white"
                    app:fabSize="normal"
                    app:maxImageSize="44dp"
                    app:borderWidth="0dp"
                    app:elevation="4dp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/createEventFab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/cd_fab_create_event"
                    android:src="@drawable/ic_add"
                    app:backgroundTint="@color/colorPrimary"
                    app:tint="@color/colorWhite"
                    app:fabSize="normal"
                    app:maxImageSize="32dp"
                    app:borderWidth="0dp"
                    app:elevation="4dp" />

                <FrameLayout
                    android:id="@+id/fabBarCollapse"
                    android:layout_width="@dimen/fab_bar_handle_width"
                    android:layout_height="@dimen/fab_bar_handle_height"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_fab_bar_handle"
                    android:clickable="true"
                    android:contentDescription="@string/fab_bar_collapse_actions"
                    android:elevation="@dimen/fab_bar_handle_elevation"
                    android:focusable="true"
                    android:scaleX="-1">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:scaleX="-1"
                        app:srcCompat="@drawable/ic_chevron_right"
                        app:tint="@android:color/white" />

                </FrameLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:id="@+id/fabBarHandle"
            android:layout_width="@dimen/fab_bar_handle_width"
            android:layout_height="@dimen/fab_bar_handle_height"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_fab_bar_handle"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="@string/fab_bar_show_actions"
            android:elevation="@dimen/fab_bar_handle_elevation">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:scaleX="-1"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_chevron_right"
                app:tint="@android:color/white" />
        </FrameLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout> 

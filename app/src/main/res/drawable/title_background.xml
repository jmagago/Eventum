<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa de fondo con gradiente -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:endColor="#30FFFFFF"
                android:centerColor="#15FFFFFF"
                android:startColor="#05FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <!-- Borde superior con gradiente -->
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:startColor="#40FFFFFF"
                android:endColor="#10FFFFFF"
                android:type="linear" />
            <size android:height="2dp" />
        </shape>
    </item>
</layer-list> 